# ========================================
# LLM API Keys
# ========================================
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here

# ========================================
# API Server Settings
# ========================================
APP_NAME=Multi-Agent Discussion API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production  # development, production

# 서버
HOST=0.0.0.0
PORT=8000

# ========================================
# Database Settings
# ========================================
# SQLite (기본값, 로컬 개발용)
DATABASE_URL=sqlite:///./discussion_api.db

# PostgreSQL (프로덕션 권장)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# 예시:
# DATABASE_URL=postgresql://persona_admin:your_password@your-db-host:5432/personadb

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# ========================================
# Security & Authentication
# ========================================
# JWT Secret Key (반드시 변경 필요!)
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters-recommended
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60  # 1시간
REFRESH_TOKEN_EXPIRE_DAYS=7  # 7일

# 비밀번호 정책
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=300  # 5분 (초)

# ========================================
# CORS Settings
# ========================================
# 쉼표로 구분된 허용 도메인 목록
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# 선택사항
# ========================================
# 로그 레벨
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# 웹 검색 API (선택)
# SERPER_API_KEY=your-serper-api-key-here
# BRAVE_API_KEY=your-brave-api-key-here
