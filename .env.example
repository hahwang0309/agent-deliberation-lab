# ========================================
# LLM API Keys
# ========================================
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
# OpenAI 호환 서버(로컬 vLLM·llama.cpp·Ollama 등)를 provider "openai"로 쓸 때. 설정하면 키가 없어도 됨
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# ========================================
# API Server Settings
# ========================================
APP_NAME=Multi-Agent Discussion API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production  # development, production

# 서버
HOST=0.0.0.0
PORT=8000

# ========================================
# Database Settings
# ========================================
# SQLite (기본값, 로컬 개발용)
DATABASE_URL=sqlite:///./discussion_api.db

# PostgreSQL (프로덕션 권장)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# 예시:
# DATABASE_URL=postgresql://persona_admin:your_password@your-db-host:5432/personadb

# MySQL
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# ========================================
# Security & Authentication
# ========================================
# JWT 서명 키 (필수, 32자 이상 무작위 값 — 비었거나 예시값이면 서버가 시작되지 않음)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 인증 쿠키 Secure 플래그 (HTTPS로 운영하면 true)
COOKIE_SECURE=false

# 비밀번호 정책
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=300  # 5분 (초)

# ========================================
# 최초 관리자 계정
# ========================================
# 관리자 계정이 하나도 없을 때 서버 시작 시 이 계정을 만든다 (첫 로그인 후 비밀번호 변경 강제).
# 관리자가 생긴 뒤에는 무시된다.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ========================================
# CORS Settings
# ========================================
# 웹 UI는 같은 출처에서 서빙되므로 보통 비워 둔다. 다른 출처의 프론트엔드가 있을 때만 쉼표로 지정.
CORS_ORIGINS=

# ========================================
# 선택사항
# ========================================
# 로그 레벨
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# 웹 검색 (선택, 토론의 "웹 검색" 옵션에 필요 — 관리자만 켤 수 있음)
# TAVILY_API_KEY=tvly-...
